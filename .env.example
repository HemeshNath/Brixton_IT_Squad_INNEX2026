# Copy to backend/.env and fill in. Never commit .env.
DEBUG=true

# Development only: accept "X-Dev-User: <name>" instead of a Firebase token (needs DEBUG=true)
ALLOW_DEV_AUTH=true

# Comma-separated, only needed for a web client
CORS_ORIGINS=

# Supabase Postgres: dashboard > Connect > Direct > Method "Session pooler" URI (port 5432, works on IPv4).
# Paste it as shown ("postgresql://..." is fine, the app adds the driver). Replace [YOUR-PASSWORD] with the
# real password WITHOUT the brackets. URL-encode special characters in the password (@ -> %40, # -> %23).
# Do NOT use the Transaction pooler (port 6543): it breaks prepared statements.
# Empty = local SQLite file backend/checkscam.db
# DATABASE_URL=postgresql://postgres.PROJECTREF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Path to the Firebase service-account JSON (Firebase console > Project settings > Service accounts).
# Keep the file OUTSIDE the project folder, e.g. C:\keys\checkscam-firebase-adminsdk.json
FIREBASE_CREDENTIALS=

# AlienVault OTX (https://otx.alienvault.com > Settings > API Key)
OTX_API_KEY=
# Seconds a slow OTX call may keep running in the background to fill the cache (the check never waits > 6 s)
OTX_TIMEOUT_SECONDS=15
# Stop calling OTX after this many calls per day (UTC); cached answers keep working
OTX_DAILY_LIMIT=5000
# Hours an OTX answer is reused
OTX_CACHE_HOURS=24

# Domain age (RDAP/WHOIS, free, no key)
WHOIS_ENABLED=true
WHOIS_TIMEOUT_SECONDS=10
DOMAIN_CACHE_DAYS=7

# Longest time one message check may take (seconds)
CHECK_TIMEOUT_SECONDS=6

# MIRA v1 (Hugging Face) - Phase 6
MIRA_ENABLED=true
MIRA_MODEL_ID=sagea-ai/Mira-v1
MIRA_REVISION=main

RATE_LIMIT=60/minute
